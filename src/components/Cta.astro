---
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Talk to us about your project',
  body = 'Send us the tenement outline or site boundary and the deliverables you need. We will come back with a fixed, itemised quote, usually within two business days.',
} = Astro.props;
---
<section class="section">
  <div class="wrap">
    <span class="ramp-rule" aria-hidden="true"></span>
    <h2>{heading}</h2>
    <p class="lede">{body}</p>
    <p><a class="btn" href="/contact/">Request a quote</a></p>
  </div>
</section>
