---
const links = [
  { href: '/services/magnetics/', label: 'Magnetics' },
  { href: '/services/lidar/', label: 'LiDAR' },
  { href: '/services/photogrammetry/', label: 'Photogrammetry' },
  { href: '/services/environmental/', label: 'Environmental' },
  { href: '/technology/', label: 'Technology' },
  { href: '/case-studies/', label: 'Case studies' },
  { href: '/about/', label: 'About' },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Magtech Surveys home">
      <img src="/logo-white.svg" alt="Magtech Surveys" />
    </a>

    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        <li><a class="nav-cta" href="/contact/">Get a quote</a></li>
      </ul>
    </nav>
  </div>
  <span class="ramp-rule ramp-rule--full" aria-hidden="true"></span>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('.nav-toggle');
    var header = document.querySelector('.site-header');
    if (!btn || !header) return;
    btn.addEventListener('click', function () {
      var open = header.classList.toggle('nav-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    // close the menu after tapping a link
    header.querySelectorAll('#site-nav a').forEach(function (a) {
      a.addEventListener('click', function () {
        header.classList.remove('nav-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open menu');
      });
    });
  })();
</script>

<style>
  .site-header { background: var(--graphite); }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .brand { display: inline-flex; align-items: center; line-height: 0; flex: 0 0 auto; }
  .brand img { height: 45px; width: auto; max-width: 60vw; display: block; }

  nav ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: #cfd2d6;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  nav a:hover { color: #fff; }
  .nav-cta { color: #fff; border: 1px solid #7d838b; padding: 0.3rem 0.7rem; }
  .nav-cta:hover { background: var(--signal); border-color: var(--signal); }

  /* Hamburger button: hidden on desktop */
  .nav-toggle {
    display: none;
    flex: 0 0 auto;
    width: 2.6rem;
    height: 2.6rem;
    background: transparent;
    border: 1px solid #7d838b;
    cursor: pointer;
    padding: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
  }
  .nav-toggle-bar {
    display: block;
    width: 1.2rem;
    height: 2px;
    background: #fff;
  }

  /* Mobile layout */
  @media (max-width: 820px) {
    .header-inner { flex-wrap: wrap; }
    .nav-toggle { display: flex; }
    /* full-width line below the logo/button row */
    #site-nav {
      display: none;
      order: 3;
      flex: 0 0 100%;
      width: 100%;
    }
    .site-header.nav-open #site-nav { display: block; }
    #site-nav ul {
      flex-direction: column;
      align-items: stretch;
      flex-wrap: nowrap;
      gap: 0;
      width: 100%;
      padding: 0.5rem 0 0.4rem;
    }
    #site-nav li { width: 100%; }
    #site-nav a {
      display: block;
      width: 100%;
      padding: 0.9rem 0;
      font-size: 1rem;
      border-top: 1px solid #3a3e44;
      white-space: normal;
    }
    #site-nav .nav-cta {
      border: 1px solid #7d838b;
      margin-top: 0.8rem;
      padding: 0.75rem 0.9rem;
      text-align: center;
    }
  }
</style>
