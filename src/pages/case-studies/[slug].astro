---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---
<Base
  title={`${study.data.title} | Case Study | Magtech Surveys`}
  description={study.data.summary}
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">CASE STUDY &middot; {study.data.location} &middot; {study.data.year}</p>
      <span class="ramp-rule" aria-hidden="true"></span>
      <h1>{study.data.title}</h1>
      <table class="spec">
        <tbody>
          <tr><th scope="row">Location</th><td>{study.data.location}</td></tr>
          <tr><th scope="row">Area</th><td>{study.data.area}</td></tr>
          <tr><th scope="row">Services</th><td>{study.data.services.join(', ')}</td></tr>
        </tbody>
      </table>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
  <Cta />
</Base>
