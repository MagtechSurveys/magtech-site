---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { Image } from 'astro:assets';
import surveyUte from '../assets/surveyute.jpg';
---
<Base
  title="About Magtech Surveys | UAV Geophysics & Mapping, Perth WA"
  description="Magtech Surveys is a Perth-based specialist in drone geophysical and remote sensing surveys. Acquired, processed and quality-controlled in-house, delivered ready for interpretation. CASA-certified operations."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">ABOUT</p>
      <span class="ramp-rule" aria-hidden="true"></span>
      <h1>About Magtech Surveys</h1>
      <p class="lede">A specialist UAV geophysics and mapping firm, based in Perth and working across Australia.</p>
      <div class="prose">
        <p>
          We acquire and process airborne magnetic, LiDAR and photogrammetric survey data for
          clients across Australia, with most projects in Western Australia. Every survey is
          planned, flown and processed in-house, and every dataset is delivered ready for
          geological interpretation. Our work spans mineral exploration, geological mapping,
          environmental monitoring and infrastructure projects.
        </p>
        <p>
          Our clients range from mineral exploration and resource companies through to
          environmental consultants, ecologists, land managers, infrastructure operators and
          government agencies.
        </p>
      </div>

      <figure class="media">
        <Image src={surveyUte} width={1300} alt="The Magtech Surveys field vehicle at a remote survey site" />
        <figcaption>Field-ready for remote-area work across WA and interstate.</figcaption>
      </figure>

      <h2>How we work</h2>
      <div class="prose">
        <p>
          Every dataset is acquired, processed and quality-controlled in-house. Clients deal
          directly with the people responsible for their project, from survey design through to
          delivery. We can come in at any stage, from initial scoping, where we help define
          survey parameters and feasibility, right through to acquisition and processing. Where
          useful, we collaborate with consulting geophysicists, environmental specialists and
          surveyors so the data fits how it will actually be used.
        </p>
      </div>

      <table class="spec">
        <tbody>
          <tr><th scope="row">Certification</th><td>CASA ReOC, Chief Remote Pilot, insured operations</td></tr>
          <tr><th scope="row">Methodology</th><td>Inter-Society Committee on UAV Geophysics Guidelines; every processing step documented</td></tr>
          <tr><th scope="row">Environment</th><td>Wildlife-aware flight planning, minimal ground disturbance, no vehicle tracks off existing access</td></tr>
          <tr><th scope="row">Coverage</th><td>Based in Perth, WA. Servicing all Australian states and territories; clustered mobilisation available for multi-site programs.</td></tr>
        </tbody>
      </table>
    </div>
  </section>
  <Cta />
</Base>
