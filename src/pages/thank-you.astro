---
import Base from '../layouts/Base.astro';
---
<Base
  title="Message sent | Magtech Surveys"
  description="Your enquiry has been sent to Magtech Surveys. We will get back to you shortly."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">CONTACT</p>
      <span class="ramp-rule" aria-hidden="true"></span>
      <h1>Message sent</h1>
      <p class="lede">
        Thanks, your enquiry has come through. We will get back to you shortly, usually within
        two business days.
      </p>
      <div class="prose">
        <p>
          If it is time-sensitive, you can also reach us directly at
          <a href="mailto:info@magtechsurveys.com.au">info@magtechsurveys.com.au</a> or
          <a href="tel:+61475981432">+61 475 981 432</a>.
        </p>
        <p><a class="btn" href="/">Back to home</a></p>
      </div>
    </div>
  </section>
</Base>
