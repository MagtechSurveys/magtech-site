---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
---
<Base
  title="Drone Photogrammetry & Aerial Imaging | Orthomosaics, 3D Models, Volumetrics | Magtech Surveys"
  description="Drone photogrammetry and aerial imaging across Australia: 20-megapixel capture, orthomosaics, digital surface models, 3D reconstructions and stockpile volumetrics, typically delivered within 24 to 72 hours."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">SERVICES / PHOTOGRAMMETRY</p>
      <span class="ramp-rule" aria-hidden="true"></span>
      <h1>Photogrammetry &amp; aerial imaging</h1>
      <p class="lede">High-resolution mapping and imagery for mining, infrastructure, land development and environmental work.</p>

      <div class="prose">
        <p>
          Our system captures 20-megapixel still images with a mechanical shutter, producing
          accurate orthomosaics, digital surface models and 3D reconstructions. That suits site
          mapping, pit modelling, stockpile volume calculation and terrain analysis, as well as
          straightforward visual documentation.
        </p>
        <p>
          In mining, aerial imaging captures up-to-date overviews of exploration leases,
          operational sites and rehabilitation areas. Imagery can be viewed directly alongside
          magnetic survey data, giving context to exploration results, supporting regulatory
          documentation, and helping communicate project progress to stakeholders. Beyond
          technical mapping, high-resolution imagery supports inspections, progress reporting and
          marketing.
        </p>
      </div>

      <table class="spec">
        <tbody>
          <tr><th scope="row">Capture</th><td>20-megapixel stills, mechanical shutter</td></tr>
          <tr><th scope="row">Resolution</th><td>Typically 1&ndash;3 cm GSD, matched to flying height and purpose</td></tr>
          <tr><th scope="row">Products</th><td>Orthomosaic, digital surface model, 3D reconstruction, stockpile and pit volumetrics</td></tr>
          <tr><th scope="row">Formats</th><td>Standard GeoTIFF and formats for GIS, CAD and visual reporting workflows. GDA2020.</td></tr>
          <tr><th scope="row">Turnaround</th><td>Most deliverables within 24 to 72 hours of completing site work</td></tr>
          <tr><th scope="row">Honest limits</th><td>Low-texture surfaces such as uniform turf or bare sand degrade photogrammetric accuracy. We recommend LiDAR where it is the better tool.</td></tr>
        </tbody>
      </table>
    </div>
  </section>
  <Cta />
</Base>
