---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { Image } from 'astro:assets';
import vegOrtho from '../../assets/nicelandscapesfromorthosurvey.png';
import satView from '../../assets/satviewofnicelandscapes.png';
import aerialCamp from '../../assets/aerialshotofcamp.jpg';
---
<Base
  title="Aerial Environmental Monitoring | Rehabilitation, Vegetation, Thermal | Magtech Surveys"
  description="Drone-based environmental monitoring across Australia: rehabilitation tracking, vegetation and erosion mapping, surface disturbance and thermal feral animal detection. Repeatable designs with baseline and change detection for compliance."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">SERVICES / ENVIRONMENTAL &amp; THERMAL</p>
      <span class="ramp-rule" aria-hidden="true"></span>
      <h1>Aerial environmental monitoring</h1>
      <p class="lede">Imaging and mapping to support environmental monitoring, land rehabilitation and compliance reporting.</p>

      <div class="prose">
        <p>
          Using high-resolution aerial photogrammetry, we capture site conditions for analysis,
          documentation and planning. Vegetation monitoring, erosion assessment and surface
          disturbance mapping are part of the standard service. Baseline imaging before site
          works, followed by change detection on later visits, supports compliance and
          rehabilitation tracking.
        </p>
        <p>
          Repeatability is the point. We fly the same lines, at the same height, with the same
          sensors, visit after visit, so successive datasets are directly comparable and change
          reflects the site rather than the survey. All data is processed for compatibility with
          GIS and CAD platforms and can be tailored for consultants, environmental teams and land
          management groups.
        </p>
        <p>
          We deliver consistent, well-documented data on schedule, including at remote sites.
          Our field experience is mining-adjacent, so remote-area logistics, site inductions and
          tenement access are familiar ground.
        </p>
      </div>

      <figure class="media">
        <Image src={vegOrtho} alt="High-resolution orthomosaic over vegetated terrain from a drone survey, for baseline and change detection" />
        <figcaption>Orthomosaic over vegetated terrain. Repeat capture at this detail supports baseline and change detection.</figcaption>
      </figure>

      <figure class="media media--feature">
        <Image src={aerialCamp} width={2000} alt="Aerial view over remote bushland during a drone survey, vehicle and launch pad among the trees" />
        <figcaption>On site in remote bushland: the survey setup from above.</figcaption>
      </figure>

      <figure class="media">
        <Image src={satView} alt="Broad-area aerial view of vegetated landscape captured by drone survey" />
        <figcaption>Broad-area capture for landscape-scale baseline and monitoring work.</figcaption>
      </figure>

      <table class="spec">
        <tbody>
          <tr><th scope="row">Rehabilitation monitoring</th><td>Multi-epoch orthomosaics and surface models, baseline plus change detection between visits</td></tr>
          <tr><th scope="row">Vegetation &amp; erosion</th><td>Vegetation structure and canopy mapping, erosion and surface disturbance mapping</td></tr>
          <tr><th scope="row">Thermal detection</th><td>Thermal imaging for wildlife survey and feral animal detection and reporting. Detection and mapping only; control work stays with licensed pest controllers.</td></tr>
          <tr><th scope="row">Deliverables</th><td>GeoTIFF orthomosaics, GIS/CAD-compatible outputs, summary reports for inclusion in compliance documentation. GDA2020.</td></tr>
          <tr><th scope="row">Coverage</th><td>Regional and remote areas across WA, and interstate by request</td></tr>
        </tbody>
      </table>
    </div>
  </section>
  <Cta heading="Planning environmental monitoring?" body="Tell us the site, the schedule and what you need to measure, and we will come back with a fixed, itemised quote." />
</Base>
